#!/usr/bin/env python3
"""Docker Registry Tool - CLI entry point.

This file is a shim that imports and runs the main Python application.
Works without pip install by adding src/ to sys.path.
"""

import os
import sys

# Add the src directory to the Python path so we can import the package
src_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "src")
if src_dir not in sys.path:
    sys.path.insert(0, src_dir)

from docker_reg_tool.cli import main

if __name__ == "__main__":
    sys.exit(main())
